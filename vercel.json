{
  "buildCommand": "npm run build && cp dist/waitlist.html dist/index.html",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/waitlist.html"
    },
    {
      "source": "/waitlist",
      "destination": "/waitlist.html"
    },
    {
      "source": "/ai-mantra-generator/:path*",
      "destination": "/:path*"
    }
  ]
}
